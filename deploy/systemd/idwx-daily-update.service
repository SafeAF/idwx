[Unit]
Description=Refresh Twin Falls Oikolab archive and publish verified IDWX static data
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/idwx/automation/runtime
EnvironmentFile=/etc/idwx/oikolab.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/idwx/automation/runtime/venv/bin/python -m idwx.daily_update --config configs/idaho.yml --source-revision @SOURCE_REVISION@
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/idwx
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

